{
  "permissions": {
    "allow": [
      "mcp__xcode__RunProject",
      "mcp__xcode__StopProject",
      "mcp__xcode__XcodeSwitchRunDestination",
      "mcp__xcode__XcodeListRunDestinations",
      "mcp__xcode__GetConsoleOutput",
      "mcp__Claude_Code_iOS_Simulator"
    ],
    "ask": [
      "mcp__xcode__BuildProject",
      "mcp__xcode__RenderPreview"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-previews-in-debug.sh",
            "timeout": 10,
            "statusMessage": "Checking #Preview is inside #if DEBUG"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-toolbar-on-screen.sh",
            "timeout": 10,
            "statusMessage": "Checking toolbar is on the Screen"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/record-edited-file.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-git-commit.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-protected-paths.sh",
            "timeout": 10,
            "statusMessage": "Checking for design-system component changes"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/require-staged-changes.sh",
            "timeout": 10,
            "statusMessage": "Checking all changes are staged"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/restore-context-after-compact.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
